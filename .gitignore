/target

# C#-мост запуска (tools/vlaunch.cs): собирается csc при первом runas/aumid/clsid —
# локальный артефакт, как vanguard_app_*.
vanguard_launch.exe

# Артефакты, которые приложение пишет в корень репозитория при работе
# (см. раздел про runtime side effects в AGENTS.md). Ни один из них не является
# исходником: скрипты генерирует ИИ, .exe/.pdb — rustc, .rs/.bat/.sh — временные.
# Без этих паттернов git status забивается мусором после каждого cargo run и /run.
vanguard_gen_*.py
vanguard_tmp_*.rs
vanguard_app_*.exe
vanguard_app_*.pdb
vanguard_script_*.bat
vanguard_script_*.sh

# Заметки блокнота: приложение пишет их сюда при каждом изменении текста.
vanguard_notes.txt

# Настройки окна «Настройки» (src/settings.rs): модель, reasoning_effort,
# keep_alive, автозапуск Ollama. Личная конфигурация машины, не исходник.
vanguard_settings.json

# Журнал диалогов для самообучения (пишет shell.rs, читает trainer/vanguard_train.py).
# Это личная переписка пользователя с моделью — в git не попадает по определению.
vanguard_dialogues.jsonl
# Результаты тренировок: LoRA-адаптеры и summary.json (веса, десятки мегабайт).
trainer/runs/

# Кэш Python, который оставляет src/optimize_project.py при запуске.
__pycache__/

# Побочные продукты СТАРОЙ версии src/optimize_project.py (см. AGENTS.md): нынешняя
# версия бэкапит во временной папке и таких файлов не оставляет, но старые могут
# лежать в дереве с прошлых запусков.
*.rs.bak

# Дистрибутив (`vg dist`): staging-папка + готовый архив под раздачу. Артефакт,
# а не исходник — собирается заново, класть его в git незачем.
/dist/

# Установленные приложения (формат apps/<id>/ из src/core/apps.rs): это копии
# из store/, созданные кнопкой «Установить». Хранилище — store/, оно трекается.
/apps/
